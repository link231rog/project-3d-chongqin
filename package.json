{
  "name": "project-3d-chongqin",
  "version": "1.0.0",
  "description": "3D Interactive Diorama of Yuzhong Peninsula, Chongqing (Three.js + Vite)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test src/*.test.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "wrangler": "^4.151.1"
  }
}
